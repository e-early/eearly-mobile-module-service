# Local dev env for eearly-mobile-module-service.
# Copy to .env, fill in the placeholders, then:
#   set -a && source .env && set +a
# before running the app (`./mvnw -pl eearly -am spring-boot:run` or the built jar).
# Matches docker/docker-compose.yml + eearly-mobile-module-keycloak run locally on :9091.

# --- Database (docker/docker-compose.yml, port 5433) ---
DB_URL=jdbc:postgresql://localhost:5433/postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=eearly_mobile

# --- Mobile Keycloak (this service's own users/tokens) ---
KEYCLOAK_URL=http://localhost:9091
KEYCLOAK_REALM=eearly-mobile
KEYCLOAK_ADMIN_CLIENT_ID=eearly-user-administrator
# Redacted in eearly-mobile-module-keycloak's realm-config export -- after importing that
# realm, fetch the real value from its admin console: Clients -> eearly-user-administrator
# -> Credentials.
KEYCLOAK_ADMIN_CLIENT_SECRET=<from Keycloak Credentials tab>
KEYCLOAK_MOBILE_CLIENT_ID=eearly-mobile
KEYCLOAK_ADMIN_SERVICE_CLIENT_ID=admin-service

# --- Patient onboarding (mobile app deep links / QR flow) ---
ONBOARDING_API_BASE_URL=http://localhost:8081
ONBOARDING_BASE_URL=http://localhost:8081
MOBILE_APP_STORE_FALLBACK_URL=https://eearly.result.si
MOBILE_KEYCLOAK_BASE_URL=http://localhost:9091
MOBILE_KEYCLOAK_HOST=localhost:9091

# --- EHRbase (openEHR) --- from eearly-ehr-module-opensource. Must be the full REST API path,
# not just the host, AND end with a trailing slash: EhrbaseClient uses this verbatim as its
# WebClient base URL and appends relative paths like `ehr/{id}` -- without the trailing slash,
# WebClient's URI resolution drops the last path segment (v1) instead of appending to it.
EHR_BASE_URL=http://localhost:8000/ehrbase/rest/openehr/v1/
EHR_KEYCLOAK_BASE_URL=http://localhost:9092
# Fetch from the running EHR Keycloak's admin console: Clients -> ehrbase -> Credentials. The
# value in eearly-ehr-module-keycloak's realm-config on disk can be stale if that Keycloak's
# Postgres volume already existed before -- --import-realm doesn't overwrite an existing client's
# secret, so whatever was generated the first time that stack ever came up is what's live now.
EHR_KEYCLOAK_CLIENT_SECRET=<from EHR Keycloak Credentials tab>

# --- Dexcom sensor integration -- optional, only needed if you exercise that flow ---
#DEXCOM_REDIRECT_URI=http://localhost:8081/dexcom/callback
#DEXCOM_CLIENT_ID=<sandbox client id>
#DEXCOM_CLIENT_SECRET=<sandbox client secret>

# --- Logging -- optional, defaults to ./logs/eearly-mobile.log if unset ---
LOGGING_FILE_PATH=/tmp/eearly-mobile.log
