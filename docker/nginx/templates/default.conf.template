map ${EEARLY_KEYCLOAK_PROXY_HOST_HEADER} $host_header_value {
	default $host;

	1 $proxy_host;
	true $proxy_host;

	0 $host;
	false $host;
}

server {

	listen 80;

	location /api/v1 {

		proxy_pass http://${EEARLY_API_HOST}:${EEARLY_API_REST_PORT}/api/v1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}

	location /mailhog {

		proxy_pass http://eearly_mailhog:8025/;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}

	location /realms/${EEARLY_KEYCLOAK_REALM}/protocol/openid-connect/token {

		access_by_lua_block
		{
			local clientId = "client_id=${EEARLY_KEYCLOAK_CLIENT_ID}"
			local clientSecret = "client_secret=${EEARLY_KEYCLOAK_CLIENT_SECRET}"

			ngx.req.read_body()
			local req = ngx.req.get_body_data()

			local prefix = clientId .. "&" .. clientSecret
			if req == nil then
				req = prefix
			else
				req = prefix .. "&" .. req
			end

			ngx.req.set_body_data(req)
		}

		proxy_pass ${EEARLY_KEYCLOAK_URL}/realms/${EEARLY_KEYCLOAK_REALM}/protocol/openid-connect/token;

		proxy_set_header Host $host_header_value;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}

	location /realms/${EEARLY_KEYCLOAK_REALM} {

		proxy_pass ${EEARLY_KEYCLOAK_URL}/realms/${EEARLY_KEYCLOAK_REALM};

		proxy_set_header Host $host_header_value;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}
}

server {

	listen 80 http2;

	### wont work
	# listen 80;
	# http2 on;
	###

	server_name grpc.*;

	location / {

		grpc_pass grpc://${EEARLY_API_HOST}:${EEARLY_API_GRPC_PORT};
	}
}
